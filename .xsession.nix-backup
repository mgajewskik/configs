if [ -z "$HM_XPROFILE_SOURCED" ]; then
  . "/home/mgajewskik/.xprofile"
fi
unset HM_XPROFILE_SOURCED

systemctl --user start hm-graphical-session.target

/nix/store/sr8a2s4y097gi6lwgmr8zckaqralkc7r-xrdb-1.2.2/bin/xrdb -merge /home/mgajewskik/.Xresources
/nix/store/p7kc979dfn9vbl9gzkkchsqx68a2hcw7-xsetroot-1.1.3/bin/xsetroot -xcf /nix/store/cdd4b4nmrpil3ly7ds33cjh44pyq5l39-phinger-cursors-2.0/share/icons/'phinger-cursors-light'/cursors/'left_ptr' 21


/nix/store/l5icn440xbiv68rgrggcyp01b7pbxvy9-i3-4.23/bin/i3

systemctl --user stop graphical-session.target
systemctl --user stop graphical-session-pre.target

# Wait until the units actually stop.
while [ -n "$(systemctl --user --no-legend --state=deactivating list-units)" ]; do
  sleep 0.5
done

systemctl --user unset-environment 'DBUS_SESSION_BUS_ADDRESS' 'DISPLAY' 'SSH_AUTH_SOCK' 'XAUTHORITY' 'XDG_DATA_DIRS' 'XDG_RUNTIME_DIR' 'XDG_SESSION_ID'
