[fan]
# command=echo "F: $(~/.config/i3blocks/i3fan)"
# command=echo "󰈐 $(~/.config/i3blocks/i3fan)"
command=echo "❄️ $(~/.config/i3blocks/i3fan)"
interval=1
seperator=false

#[uptime]
#command=echo "UPT: $(~/.config/i3blocks/i3uptime)"
#separator=true
#interval=60

# Volume indicator
#
# Displays both the master and the headphone volume
[volume]
command=~/.config/i3blocks/i3volume
interval=1
signal=1

# Backlight Level
[light]
# command=echo "☀️️ $(light -G)%"
# command=echo " $(light -G)%"
# command=echo "󰖨 $(light -G)%"
command=echo "☀️ $(light -G)%"
interval=1
signal=4

# Battery indicator
#
# The battery instance defaults to 0.
[battery]
command=~/.config/i3blocks/i3battery
interval=1

[bat]
# command=echo "󱊥 $(~/.config/i3blocks/i3bat-watt)"
command=echo "⚡ $(~/.config/i3blocks/i3bat-watt)"
interval=1
seperator=false


# Date Time
[time]
# command=date '+ %V  %d-%m-%Y   %H:%M:%S '
command=date '+ %V 📆 %d-%m-%Y 🕓 %H:%M:%S '
interval=1

