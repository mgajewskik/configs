# #---Chained Commands---# #
# resize window (you can also use the mouse for that)
bindsym $mod+r mode "resize"
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym l resize shrink width 5 px or 5 ppt
        bindsym k resize grow height 5 px or 5 ppt
        bindsym j resize shrink height 5 px or 5 ppt
        bindsym h resize grow width 5 px or 5 ppt

        # same bindings, but for the arrow keys
        bindsym Right resize shrink width 10 px or 10 ppt
        bindsym Up resize grow height 10 px or 10 ppt
        bindsym Down resize shrink height 10 px or 10 ppt
        bindsym Left resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+b mode "$mode_blue"
set $mode_blue (d)own, (u)p, (r)estart
mode "$mode_blue" {
    bindsym u $exec blugon --setcurrent="+600", mode "default"
    bindsym d $exec blugon --setcurrent="-600", mode "default"
    bindsym r $exec systemctl --user restart blugon.service, mode "default"

    # exit system mode: "Enter" or "Escape"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Set shut down, restart and locking features
bindsym $mod+Escape mode "$mode_system"
set $mode_system (l)ock, (e)xit, switch_(u)ser, (s)uspend, (h)ibernate, (r)eboot, (Shift+s)hutdown
mode "$mode_system" {
    bindsym l $exec i3exit lock, mode "default"
    bindsym s $exec i3exit suspend, mode "default"
    bindsym u $exec i3exit switch_user, mode "default"
    bindsym e $exec i3exit logout, mode "default"
    bindsym h $exec i3exit hibernate, mode "default"
    bindsym r $exec i3exit reboot, mode "default"
    bindsym Shift+s $exec i3exit shutdown, mode "default"

    # exit system mode: "Enter" or "Escape"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

## Manual management of external displays
bindsym $mod+m mode "$mode_display"
set $mode_display Choose monitor connection: (s)ingle, (d)ell, (p)rojector, (w)allpaper, ThinkVision-(r)ight, ThinkVision-(l)eft, (a)ll, (t)otal
mode "$mode_display" {
    bindsym s $exec xrandr --auto --output eDP --primary && notify-send 'Single monitor configured' && $wallpaper_reset, mode "default"
    bindsym e $exec xrandr --auto --output DisplayPort-1 --auto --left-of eDP && notify-send 'Dell monitor configured on the left side' && $wallpaper_reset, mode "default"
    bindsym d $exec xrandr --auto --output DisplayPort-1 --primary --auto --above eDP && notify-send 'Dell monitor configured' && $wallpaper_reset, mode "default"
    bindsym o $exec xrandr --auto --output DisplayPort-1 --primary --output eDP --off && notify-send 'Only Dell monitor configured ThinkPad turned off' && $wallpaper_reset, mode "default"-
    bindsym p $exec xrandr --auto --output HDMI-A-0 --primary --auto --same-as eDP && notify-send 'HDMI projector configured' && $wallpaper_reset, mode "default"
    bindsym r $exec xrandr --auto --output eDP --primary --left-of DisplayPort-1 && notify-send 'ThinkVision configured on the right side' && $wallpaper_reset, mode "default"
    bindsym l $exec xrandr --auto --output eDP --primary --right-of DisplayPort-1 && notify-send 'ThinkVision configured on the left side' && $wallpaper_reset, mode "default"
    bindsym u $exec xrandr --auto --output eDP --primary --below DisplayPort-1 && notify-send 'ThinkVision configured on the left side' && $wallpaper_reset, mode "default"
    bindsym a $exec xrandr --output DP-1-2 --primary --auto --above eDP-1 --output DP-1-1 --auto --right-of eDP-1 && notify-send 'ThinkVision and Dell configured in integrated mode' && $wallpaper_reset, mode "default"
    bindsym a $exec xrandr --output DisplayPort-1 --primary --auto --left-of eDP --output DisplayPort-0 --auto --above eDP && notify-send 'ThinkVision and Dell configured on the right' && $wallpaper_reset, mode "default"
    bindsym t $exec xrandr --output DP-1 --primary --auto --above eDP-1-1 --output DP-0 --auto --right-of eDP-1-1 && notify-send 'ThinkVision and Dell configured in nvidia mode' && $wallpaper_reset, mode "default"
    bindsym w $exec $wallpaper_reset

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

## Manual moving of all windows between monitors
bindsym $alt+d mode "$mode_windows"
set $mode_windows Move windows: (d)ell, (s)mall
mode "$mode_windows" {
    bindsym d $exec "~/scripts/i3move dell && notify-send 'Moved all windows to Dell'", mode "default"
    bindsym s $exec "~/scripts/i3move small && notify-send 'Moved all windows to smaller screen'", mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

