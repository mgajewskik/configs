# #---Basic setup---# #
smart_gaps on
smart_borders on

set $mod Mod4
set $alt Mod1
set $exec exec --no-startup-id
set $exec_always exec_always --no-startup-id
set $term exec --no-startup-id alacritty
set $wallpaper_reset feh --bg-fill --no-fehbg ~/pictures/Wallpapers/firewatch_6.jpg && notify-send 'wallpaper reset'

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod


# #---Gaps---# #
for_window [class="^.*"] border pixel 3
gaps inner 0
gaps outer 0


# #---Autostart---# #
$exec_always $wallpaper_reset
$exec_always systemctl --user start greenclip.service
#$exec_always "sudo /home/mgajewskik/bin/set-thermals.sh && notify-send 'Thermals set'"
#$exec_always picom --config ~/.config/picom.conf

$exec xinput set-prop "TPPS/2 Elan TrackPoint" "libinput Natural Scrolling Enabled" 1
$exec xinput set-prop "TPPS/2 Elan TrackPoint" "libinput Accel Speed" 0.1
$exec xinput set-prop "SYNA8009:00 06CB:CE57 Touchpad" "libinput Accel Speed" 0.3
$exec xinput set-prop "SYNA8009:00 06CB:CE57 Touchpad" "libinput Natural Scrolling Enabled" 1
$exec xinput set-prop "SYNA8009:00 06CB:CE57 Touchpad" "libinput Tapping Enabled" 1
$exec xinput set-prop "MOSART Semi. Trust Wireless Mouse" "libinput Accel Speed" 1

#$exec_always /usr/bin/setxkbmap -option "ctrl:nocaps"
#$exec_always setxkbmap pl
$exec_always setxkbmap pl -option "ctrl:nocaps"
