{
    "layer": "top", // Waybar at top layer
    "position": "top",
    "height": 20,

    "modules-left": [
        "hyprland/workspaces",
        "sway/mode",
        "custom/media"
    ],
    "modules-center": [],
    "modules-right": [
        "idle_inhibitor",
        "custom/separator",
        "tray", 
        "custom/separator",
        "pulseaudio", 
        "custom/separator",
        "backlight",
        "custom/separator",
        "custom/fan",
        "custom/separator",
        "custom/battery-draw",
        "battery", 
        "custom/separator",
        "clock"
    ],

    // Modules configuration
    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "custom/exit": {
        "format": "",
        "tooltip-format": "Powermenu",
        "on-click": "wlogout -b 4",
        "tooltip": false
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% {icon}",
        "format-icons": [
        "󰃞 ",
        "󰃝 ",
        "󰃟 ",
        "󰃠 "
        ],
        "scroll-step": 5
    },

     "hyprland/workspaces": {
         "disable-scroll": true,
         "format":"{name}",
         "format-icons": {
             "1": "",
             "2": "",
             "3": "",
             "4": "",
             "5": "",
	     "6": "",
	     "7": "",
             "urgent": "",
             "focused": "",
             "default": ""
         }
     },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "on-click": "bash ~/scripts/toggle_hypridle.sh"
    },

    "clock": {
        "format": "󰸗 {:%a %d-%m-%Y %T}",
    	"interval": 1
    },

    "network": {
        "format-wifi": "󰖩 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈁 {ifname} {bandwidthUpBits} {bandwidthDownBits}",
        "format-linked": " (No IP) ",
        "format-disconnected": "󰖪",
        "interval": 1
    },

    "cpu": {
        "format": "{usage}% ",
        "interval": 1
    },

    "memory": {
        "format": "{percentage}% 󰍛",
        "interval": 1
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "ﱝ {icon} {format_source}",
        "format-muted": "0% {icon}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" ", " ", ""]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "bat": "BAT0",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon} {time}",
        "format-time": "{H}h{M}m",
        "format-charging": "{capacity}% 󰂅",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{time}"
    },

    "custom/fan": {
        "format": "{} RPM",
        "exec": "sensors | grep -E '^fan1:' | awk '{print $2}' | sed 's/+//;s/RPM//'",
        "interval": 1
    },

    "custom/battery-draw": {
        "format": "{} W",
        "exec": "upower -d | grep -E 'energy-rate' | awk '{print $2}' | head -n 1 | xargs printf '%.1f\n'",
        "interval": 1
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% {icon}",
        "format-icons": [
        "󰃞 ",
        "󰃝 ",
        "󰃟 ",
        "󰃠 "
        ],
        "scroll-step": 5
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    "custom/media": {
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    }
}
